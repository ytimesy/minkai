<main>
  <section class="hero">
    <div>
      <p class="eyebrow">Open development village</p>
      <h1>みんなの開発村</h1>
      <p class="lead">
        機械、ロボット、政策、Webサイト、料理まで。誰でも開発テーマを持ち込み、
        設計の論点を整理しながら、協力者と前に進める場所です。
      </p>
      <div class="hero-actions">
        <%= link_to "開発テーマを投稿", new_project_path, class: "button" %>
        <%= link_to "公開中のテーマを見る", "#projects", class: "button button-secondary" %>
      </div>
    </div>
    <aside class="design-board" aria-label="設計支援の観点">
      <h2>設計キャンバス</h2>
      <ul>
        <li><span>1</span> 誰の課題か</li>
        <li><span>2</span> 成功条件は何か</li>
        <li><span>3</span> どの専門性が必要か</li>
        <li><span>4</span> 次の試作は何か</li>
      </ul>
    </aside>
  </section>

  <section class="section" id="projects">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Projects</p>
        <h2>開発テーマ</h2>
      </div>
      <%= link_to "新しく投稿", new_project_path, class: "button button-small" %>
    </div>

    <% if @projects.any? %>
      <div class="project-grid">
        <% @projects.each do |project| %>
          <article class="project-card">
            <div class="card-meta">
              <span><%= project.category %></span>
              <span><%= project.status %></span>
            </div>
            <h3><%= link_to project.title, project %></h3>
            <p><%= project.summary %></p>
            <dl>
              <div>
                <dt>参加募集</dt>
                <dd><%= project.participation_needs %></dd>
              </div>
              <div>
                <dt>参加メモ</dt>
                <dd><%= project.contributions.size %>件</dd>
              </div>
            </dl>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <h3>最初の開発テーマを投稿してください。</h3>
        <p>未完成のアイデアでも、課題と成功条件があれば始められます。</p>
        <%= link_to "投稿する", new_project_path, class: "button" %>
      </div>
    <% end %>
  </section>
</main>
