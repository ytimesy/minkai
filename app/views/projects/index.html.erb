<main>
  <section class="hero">
    <div>
      <p class="eyebrow">Open development village</p>
      <h1>みんなの開発村</h1>
      <p class="lead">
        アイデアを、要求仕様・設計・部品表・試験項目へ分解する共同開発ワークスペース。
      </p>
      <div class="hero-actions">
        <%= link_to "開発テーマを投稿", new_project_path, class: "button" %>
        <%= link_to "公開中のテーマを見る", "#projects", class: "button button-secondary" %>
      </div>
    </div>
    <aside class="design-board robot-hero-panel" aria-label="設計支援の観点">
      <img src="/images/robot-hero.jpg" alt="ロボット開発ワークスペースのイメージ">
      <h2>~~~ Development Drill Menu ~~~</h2>
      <ul>
        <li><span>REQ</span> 要求仕様</li>
        <li><span>BOM</span> 部品表</li>
        <li><span>TEST</span> 試験項目</li>
        <li><span>LOG</span> 開発ログ</li>
      </ul>
    </aside>
  </section>

  <section class="section" id="projects">
    <div class="section-heading">
      <div>
        <p class="eyebrow">Projects</p>
        <h2>~~~ Development Table of Contents ~~~</h2>
      </div>
      <%= link_to "新しく投稿", new_project_path, class: "button button-small" %>
    </div>

    <% if @projects.any? %>
      <div class="project-grid">
        <% @projects.each do |project| %>
          <article class="project-card">
            <div class="card-meta">
              <span><%= project.category %></span>
              <span><%= project.status %></span>
            </div>
            <h3><%= link_to project.title, project %></h3>
            <p><%= project.summary %></p>
            <dl>
              <div>
                <dt>参加募集</dt>
                <dd><%= project.participation_needs %></dd>
              </div>
              <div>
                <dt>参加メモ</dt>
                <dd><%= project.contributions.size %>件</dd>
              </div>
            </dl>
          </article>
        <% end %>
      </div>
    <% else %>
      <div class="empty-state">
        <h3>最初の開発テーマを投稿してください。</h3>
        <p>未完成のアイデアでも、課題と成功条件があれば始められます。</p>
        <%= link_to "投稿する", new_project_path, class: "button" %>
      </div>
    <% end %>
  </section>
</main>
