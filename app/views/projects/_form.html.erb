<%= form_with model: project, class: "project-form" do |form| %>
  <% if project.errors.any? %>
    <div class="errors">
      <strong>入力内容を確認してください。</strong>
      <ul>
        <% project.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="field">
    <%= form.label :title, "開発テーマ名" %>
    <%= form.text_field :title, placeholder: "例: 災害時に使える小型搬送ロボット" %>
  </div>

  <div class="form-grid">
    <div class="field">
      <%= form.label :category, "領域" %>
      <%= form.select :category, Project::CATEGORIES, prompt: "選択してください" %>
    </div>

    <div class="field">
      <%= form.label :status, "段階" %>
      <%= form.select :status, Project::STATUSES %>
    </div>
  </div>

  <div class="field">
    <%= form.label :summary, "一言でいうと" %>
    <%= form.text_area :summary, rows: 3, placeholder: "何を作り、何を良くするのかを書いてください。" %>
  </div>

  <div class="field">
    <%= form.label :problem, "解きたい課題" %>
    <%= form.text_area :problem, rows: 4, placeholder: "現状の困りごと、制約、未解決の論点。" %>
  </div>

  <div class="field">
    <%= form.label :target_users, "使う人・影響を受ける人" %>
    <%= form.text_area :target_users, rows: 3, placeholder: "誰のための開発か。利用場面も含めて。" %>
  </div>

  <div class="field">
    <%= form.label :success_metric, "うまくいったと言える条件" %>
    <%= form.text_area :success_metric, rows: 3, placeholder: "性能、価格、時間、安全性、満足度などの判断基準。" %>
  </div>

  <div class="field">
    <%= form.label :participation_needs, "参加してほしいこと" %>
    <%= form.text_field :participation_needs, placeholder: "例: 設計レビュー、試作、法制度調査、レシピ検証" %>
  </div>

  <div class="field">
    <%= form.label :specifications, "仕様" %>
    <%= form.text_area :specifications, rows: 5, placeholder: "材料、寸法、性能、対象環境、安全条件、予算など。" %>
  </div>

  <div class="field">
    <%= form.label :features, "機能" %>
    <%= form.text_area :features, rows: 5, placeholder: "利用者ができること、管理者ができること、優先度、将来追加したい機能。" %>
  </div>

  <section class="stage-form-section">
    <div>
      <p class="eyebrow">Development document</p>
      <h2>開発ドキュメント</h2>
    </div>

    <div class="field">
      <%= form.label :intended_uses, "想定用途" %>
      <%= form.text_area :intended_uses, rows: 4, placeholder: "小型搬送、教材、案内補助、基礎研究など。" %>
    </div>

    <div class="field">
      <%= form.label :scope_limits, "MVPでやらないこと・制約条件" %>
      <%= form.text_area :scope_limits, rows: 5, placeholder: "人を乗せない、屋外公道を走らない、危険物を扱わない、完全自律判断をしない等。" %>
    </div>

    <div class="field">
      <%= form.label :system_architecture, "システム全体図" %>
      <%= form.text_area :system_architecture, rows: 5, placeholder: "入力、指示解釈、行動計画、制御、安全停止の流れ。" %>
    </div>

    <div class="field">
      <%= form.label :basic_design, "基本設計" %>
      <%= form.text_area :basic_design, rows: 6, placeholder: "目的、MVP範囲、全体構成、主要機能、画面・構造の大枠。" %>
    </div>

    <div class="form-grid">
      <div class="field">
        <%= form.label :detail_design, "詳細設計" %>
        <%= form.text_area :detail_design, rows: 6, placeholder: "基本設計を実装・試作できる粒度に分解。例外処理、部品配置、制御、運用も記録。" %>
      </div>

      <div class="field">
        <%= form.label :data_transition_design, "データ遷移設計" %>
        <%= form.text_area :data_transition_design, rows: 6, placeholder: "入力、状態、成果物、レビュー、試験結果がどの順序で変化するか。" %>
      </div>
    </div>

    <div class="form-grid">
      <div class="field">
        <%= form.label :mechanical_design, "機械設計" %>
        <%= form.text_area :mechanical_design, rows: 6, placeholder: "本体サイズ、車輪構成、重心、センサー位置、非常停止ボタン位置。" %>
      </div>

      <div class="field">
        <%= form.label :electrical_design, "電気設計" %>
        <%= form.text_area :electrical_design, rows: 6, placeholder: "制御コンピュータ、モータードライバ、バッテリー、ヒューズ、距離センサー。" %>
      </div>
    </div>

    <div class="field">
      <%= form.label :bill_of_materials, "部品表" %>
      <%= form.text_area :bill_of_materials, rows: 7, placeholder: "カテゴリ / 部品名 / 用途 / 数量 / 候補品 / 代替案 / 注意点。" %>
    </div>

    <div class="field">
      <%= form.label :software_design, "ソフトウェア構成" %>
      <%= form.text_area :software_design, rows: 6, placeholder: "音声・テキスト・ボタン入力、コマンド変換、走行制御、安全停止、ログ記録。" %>
    </div>

    <div class="field">
      <%= form.label :safety_design, "安全設計" %>
      <%= form.text_area :safety_design, rows: 7, placeholder: "危険源、想定リスク、対策、試験方法、残る課題。" %>
    </div>

    <div class="form-grid">
      <div class="field">
        <%= form.label :manufacturing_steps, "製造手順" %>
        <%= form.text_area :manufacturing_steps, rows: 7, placeholder: "フレーム、車輪、電源、制御、センサー、非常停止、走行テスト。" %>
      </div>

      <div class="field">
        <%= form.label :test_plan, "試験項目" %>
        <%= form.text_area :test_plan, rows: 7, placeholder: "前進、停止、旋回、障害物停止、非常停止、連続動作、通信切断停止。" %>
      </div>
    </div>

    <div class="field">
      <%= form.label :development_log, "開発ログ" %>
      <%= form.text_area :development_log, rows: 5, placeholder: "日付ごとの意思決定、部品候補、試験結果、課題。" %>
    </div>

    <div class="field">
      <%= form.label :next_prototype, "次の試作" %>
      <%= form.text_area :next_prototype, rows: 4, placeholder: "次に作るモデル、確認する動作、必要な協力。" %>
    </div>
  </section>

  <section class="stage-form-section">
    <div>
      <p class="eyebrow">Development stages</p>
      <h2>製造・開発の4段階</h2>
    </div>

    <div class="stage-form-grid">
      <%= form.fields_for :development_stages do |stage_form| %>
        <article class="stage-form-card">
          <%= stage_form.hidden_field :phase %>
          <%= stage_form.hidden_field :position %>
          <h3><%= stage_form.object.phase %></h3>

          <div class="field">
            <%= stage_form.label :image_description, "イメージ図" %>
            <%= stage_form.text_area :image_description, rows: 3, placeholder: "この段階で見せたい外観・利用場面。" %>
          </div>

          <div class="field">
            <%= stage_form.label :model_description, "モデル" %>
            <%= stage_form.text_area :model_description, rows: 3, placeholder: "スケッチ、試作、画面、模型、運用モデルなど。" %>
          </div>

          <div class="field">
            <%= stage_form.label :blueprint_notes, "設計図メモ" %>
            <%= stage_form.text_area :blueprint_notes, rows: 3, placeholder: "寸法、構成、工程、検証項目。" %>
          </div>
        </article>
      <% end %>
    </div>
  </section>

  <%= form.submit project.persisted? ? "開発内容を更新する" : "開発テーマを公開する", class: "button" %>
<% end %>
