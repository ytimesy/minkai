<main class="workspace-page">
  <section class="project-detail">
    <div class="card-meta">
      <span><%= @project.category %></span>
      <span><%= @project.status %></span>
    </div>
    <p class="eyebrow"><%= @section_label %></p>
    <h1><%= @project.title %></h1>
    <p class="lead compact"><%= @project.summary %></p>
    <% if @project.category == "ロボット" || @project.component_project? %>
      <figure class="workspace-robot-image">
        <img src="/images/robot-hero.jpg" alt="ロボット開発ワークスペースのイメージ">
      </figure>
    <% end %>

    <% if @project.component_project? && @project.parent_project.present? %>
      <section class="component-parent-banner">
        <div>
          <p class="eyebrow">Parent project</p>
          <h2><%= link_to @project.parent_project.title, @project.parent_project %></h2>
          <% if @project.source_bom_item.present? %>
            <p><%= @project.source_bom_item.tracking_id %> <%= @project.source_bom_item.name %> から作成された子開発ページです。</p>
          <% end %>
        </div>
        <% if @project.safety_review_required? %>
          <strong>安全レビュー必須</strong>
        <% end %>
      </section>
    <% end %>

    <% case @section %>
    <% when "overview" %>
      <section class="document-section toc-panel">
        <p class="eyebrow">Workspace index</p>
        <h2>~~~ Robot Development Table of Contents ~~~</h2>
        <div class="document-nav">
          <% @project.workspace_sections.each do |section_key, section_label| %>
            <% path = section_key == "overview" ? project_path(@project) : project_section_path(@project, section: section_key) %>
            <%= link_to section_label, path %>
          <% end %>
        </div>
      </section>

      <section class="maturity-panel">
        <div>
          <p class="eyebrow">Workspace maturity</p>
          <h2>開発成熟度 <%= @project.maturity_score %> / 100</h2>
        </div>
        <div class="maturity-bars">
          <% @project.maturity_breakdown.each do |label, value| %>
            <div class="maturity-row">
              <span><%= label %></span>
              <div class="maturity-track"><i style="width: <%= value %>%"></i></div>
              <strong><%= value %>%</strong>
            </div>
          <% end %>
        </div>
      </section>

      <% if @project.next_tasks.any? %>
        <section class="document-section next-actions">
          <p class="eyebrow">Next actions</p>
          <h2>次にやること</h2>
          <div class="task-board compact-task-board">
            <% @project.next_tasks.each_with_index do |task, index| %>
              <article>
                <span><%= format("TASK-%03d", index + 1) %></span>
                <h3><%= task.title %></h3>
                <p><%= task.description %></p>
                <small><%= task.related_area %> / <%= task.assignee.presence || "募集中" %></small>
              </article>
            <% end %>
          </div>
        </section>
      <% end %>

      <% if @project.traceability_rows.any? %>
        <section class="document-section">
          <p class="eyebrow">Traceability</p>
          <h2>関連トレース</h2>
          <div class="trace-list">
            <% @project.traceability_rows.each do |row| %>
              <article class="trace-card">
                <div class="trace-chain">
                  <span><%= row[:requirement].presence || "REQ未設定" %></span>
                  <span><%= row[:part].presence || "BOM未設定" %></span>
                  <span><%= row[:safety].presence || "SAFE未設定" %></span>
                  <span><%= row[:test].presence || "TEST未設定" %></span>
                  <span><%= row[:task] %></span>
                </div>
                <h3><%= row[:title] %></h3>
                <p><%= row[:status] %></p>
              </article>
            <% end %>
          </div>
        </section>
      <% end %>

      <section class="document-section">
        <h2>プロジェクト概要</h2>
        <div class="canvas-grid">
          <section>
            <h3>目的</h3>
            <%= simple_format(@project.problem) %>
          </section>
          <section>
            <h3>想定用途</h3>
            <%= simple_format(@project.intended_uses) %>
          </section>
          <section>
            <h3>現在の段階</h3>
            <p><%= @project.status %></p>
          </section>
          <section>
            <h3>次の試作</h3>
            <%= simple_format(@project.next_prototype) %>
          </section>
        </div>
      </section>

      <section class="stage-roadmap document-section">
        <p class="eyebrow">Build roadmap</p>
        <h2>製造・開発イメージ</h2>
        <div class="stage-grid">
          <% @project.development_stages.each do |stage| %>
            <article class="stage-card">
              <div class="stage-visual" aria-label="<%= stage.phase %>のイメージ図">
                <div class="visual-axis"></div>
                <div class="visual-block visual-main"><%= stage.phase %></div>
                <div class="visual-block visual-sub"></div>
                <div class="visual-line"></div>
              </div>
              <div class="card-meta">
                <span><%= stage.phase %></span>
                <span><%= @project.stage_label %></span>
              </div>
              <h3>イメージ図</h3>
              <p><%= @project.stage_description(stage, :image_description) %></p>
              <h3>モデル</h3>
              <p><%= @project.stage_description(stage, :model_description) %></p>
              <h3><%= @project.food? ? "レシピメモ" : "設計図メモ" %></h3>
              <p><%= @project.stage_description(stage, :blueprint_notes) %></p>
            </article>
          <% end %>
        </div>
      </section>

    <% when "requirements" %>
      <section class="document-section">
        <h2><%= @section_label %></h2>
        <div class="canvas-grid">
          <section>
            <h3><%= @project.food? ? "誰が作る・食べるか" : "誰の課題か" %></h3>
            <%= simple_format(@project.target_users) %>
          </section>
          <section>
            <h3><%= @project.food? ? "作れるもの" : "できること" %></h3>
            <%= simple_format(@project.features) %>
          </section>
          <section>
            <h3><%= @project.food? ? "作らない範囲・注意" : "MVPでやらないこと" %></h3>
            <%= simple_format(@project.scope_limits) %>
          </section>
          <section>
            <h3><%= @project.food? ? "おいしさ・再現条件" : "成功条件" %></h3>
            <div class="requirement-list">
              <% @project.requirement_items.each do |item| %>
                <div>
                  <strong><%= item[:id] %></strong>
                  <span><%= item[:body] %></span>
                </div>
              <% end %>
            </div>
          </section>
          <section>
            <h3><%= @project.food? ? "レシピ条件" : "仕様" %></h3>
            <%= simple_format(@project.specifications) %>
          </section>
        </div>
      </section>

    <% when "blueprints" %>
      <section class="document-section">
        <h2><%= @design_section_label %></h2>
        <nav class="document-nav" aria-label="<%= @project.document_word %>ページ">
          <% @project.design_sections.each do |key, label| %>
            <% path = key == "overview" ? project_section_path(@project, section: "blueprints") : project_design_section_path(@project, section: "blueprints", design_section: key) %>
            <%= link_to label, path, class: ("active" if @design_section == key) %>
          <% end %>
        </nav>

        <% case @design_section %>
        <% when "overview" %>
          <div class="blueprint-grid">
            <article class="diagram-card">
              <h3><%= @project.design_section_label("basic") %></h3>
              <div class="design-outline">
                <% if @project.food? %>
                  <span>食べる人・場面</span>
                  <span>味の方向性</span>
                  <span>材料の範囲</span>
                  <span>調理時間</span>
                <% else %>
                  <span>目的・対象者</span>
                  <span>MVP範囲</span>
                  <span>システム全体構成</span>
                  <span>主要機能</span>
                <% end %>
              </div>
              <%= simple_format(@project.basic_design) %>
              <%= link_to "#{@project.design_section_label("basic")}を開く", project_design_section_path(@project, section: "blueprints", design_section: "basic") %>
            </article>
            <article class="diagram-card">
              <h3><%= @project.design_section_label("detail") %></h3>
              <div class="design-outline">
                <% if @project.food? %>
                  <span>材料</span>
                  <span>分量</span>
                  <span>火加減</span>
                  <span>盛り付け</span>
                <% else %>
                  <span>機械設計</span>
                  <span>電気設計</span>
                  <span>ソフトウェア設計</span>
                  <span>例外・運用</span>
                <% end %>
              </div>
              <%= simple_format(@project.detail_design) %>
              <%= link_to "#{@project.design_section_label("detail")}を開く", project_design_section_path(@project, section: "blueprints", design_section: "detail") %>
            </article>
            <article class="diagram-card">
              <h3><%= @project.design_section_label("data-transition") %></h3>
              <div class="state-diagram">
                <% if @project.food? %>
                  <span>材料確認</span>
                  <span>下処理</span>
                  <span>調理</span>
                  <span>試食記録</span>
                <% else %>
                  <span>投稿</span>
                  <span>仕様化</span>
                  <span>設計化</span>
                  <span>試験結果</span>
                <% end %>
              </div>
              <%= simple_format(@project.data_transition_design) %>
              <%= link_to "#{@project.design_section_label("data-transition")}を開く", project_design_section_path(@project, section: "blueprints", design_section: "data-transition") %>
            </article>
          </div>
        <% when "basic" %>
          <div class="blueprint-grid two-column">
            <article class="diagram-card">
              <h3><%= @project.food? ? "レシピ全体の流れ" : "システム全体図" %></h3>
              <% if @project.food? %>
                <div class="flow-diagram">
                  <span>材料確認</span>
                  <span>下処理</span>
                  <span>加熱</span>
                  <span>味見</span>
                  <span>盛り付け</span>
                  <span>保存・記録</span>
                </div>
              <% else %>
                <div class="flow-diagram">
                  <span>人の指示</span>
                  <span>音声 / テキスト / ボタン</span>
                  <span>指示解釈</span>
                  <span>行動計画</span>
                  <span>モーター制御</span>
                  <span>車輪・本体移動</span>
                </div>
              <% end %>
              <%= simple_format(@project.system_architecture) %>
            </article>
            <article class="diagram-card">
              <h3><%= @project.food? ? "基本レシピメモ" : "基本設計メモ" %></h3>
              <%= simple_format(@project.basic_design) %>
            </article>
          </div>
        <% when "detail" %>
          <% if @project.food? %>
            <div class="blueprint-grid">
              <article class="diagram-card">
                <h3>材料</h3>
                <div class="design-outline">
                  <span>主材料</span>
                  <span>調味料</span>
                  <span>代替材料</span>
                  <span>アレルゲン</span>
                </div>
                <%= simple_format(@project.mechanical_design) %>
              </article>
              <article class="diagram-card">
                <h3>分量・火加減</h3>
                <div class="wiring-diagram">
                  <span>分量</span>
                  <span>温度</span>
                  <span>時間</span>
                  <span>器具</span>
                  <span>保存</span>
                  <span>注意点</span>
                </div>
                <%= simple_format(@project.electrical_design) %>
              </article>
              <article class="diagram-card">
                <h3>詳細レシピメモ</h3>
                <%= simple_format(@project.detail_design) %>
                <h3>記録・共有</h3>
                <%= simple_format(@project.software_design) %>
              </article>
            </div>
          <% else %>
            <div class="blueprint-grid">
              <article class="diagram-card">
                <h3>機械設計</h3>
                <div class="robot-blueprint" aria-label="小型ロボット設計図">
                  <div class="robot-body"></div>
                  <div class="robot-wheel left"></div>
                  <div class="robot-wheel right"></div>
                  <div class="robot-caster"></div>
                  <div class="robot-sensor"></div>
                  <div class="robot-stop">停止</div>
                </div>
                <%= simple_format(@project.mechanical_design) %>
              </article>
              <article class="diagram-card">
                <h3>電気設計</h3>
                <div class="wiring-diagram">
                  <span>バッテリー</span>
                  <span>ヒューズ</span>
                  <span>非常停止</span>
                  <span>制御PC</span>
                  <span>モータードライバ</span>
                  <span>左右モーター</span>
                  <span>距離センサー</span>
                </div>
                <%= simple_format(@project.electrical_design) %>
              </article>
              <article class="diagram-card">
                <h3>詳細設計メモ</h3>
                <%= simple_format(@project.detail_design) %>
                <h3>ソフトウェア設計</h3>
                <%= simple_format(@project.software_design) %>
              </article>
            </div>
          <% end %>
        <% when "data-transition" %>
          <div class="blueprint-grid single-column">
            <article class="diagram-card">
              <h3><%= @project.food? ? "調理・保存の流れ" : "データ・状態の遷移" %></h3>
              <div class="state-diagram">
                <% if @project.food? %>
                  <span>材料</span>
                  <span>下処理</span>
                  <span>調理</span>
                  <span>味見</span>
                  <span>保存</span>
                  <span>写真記録</span>
                  <span>再現テスト</span>
                  <span>完成レシピ</span>
                <% else %>
                  <span>アイデア</span>
                  <span>要求仕様</span>
                  <span>設計案</span>
                  <span>部品表</span>
                  <span>リスク</span>
                  <span>試作タスク</span>
                  <span>試験結果</span>
                  <span>成果物</span>
                <% end %>
              </div>
              <%= simple_format(@project.data_transition_design) %>
            </article>
          </div>
        <% end %>
      </section>

    <% when "bom" %>
      <section class="document-section">
        <h2><%= @section_label %></h2>
        <% if @project.project_parts.any? %>
          <div class="data-table">
            <div class="data-head">
              <% if @project.food? %>
                <span>ID</span><span>分類</span><span>材料名</span><span>用途</span><span>分量</span><span>候補</span><span>価格</span><span>代替案</span><span>注意点</span><span>調達方針</span><span>要求ID</span><span>関連試験ID</span><span>子開発ページ</span><span>開発状態</span><span>操作</span>
              <% else %>
                <span>ID</span><span>カテゴリ</span><span>部品名</span><span>用途</span><span>数量</span><span>候補品</span><span>概算価格</span><span>代替案</span><span>注意点</span><span>調達方針</span><span>要求ID</span><span>関連試験ID</span><span>子開発ページ</span><span>開発状態</span><span>操作</span>
              <% end %>
            </div>
            <% @project.project_parts.each do |part| %>
              <div class="data-row">
                <span><%= part.tracking_id %></span>
                <span><%= part.category %></span>
                <span><%= part.name %></span>
                <span><%= part.purpose %></span>
                <span><%= part.quantity %></span>
                <span><%= part.candidate %></span>
                <span><%= part.estimated_price %></span>
                <span><%= part.alternative %></span>
                <span><%= part.note %></span>
                <span><%= part.procurement_policy_label %></span>
                <span><%= part.requirement_ids.presence || "未設定" %></span>
                <span><%= part.test_ids.presence || "未設定" %></span>
                <span>
                  <% if part.valid_child_project.present? %>
                    <%= link_to part.valid_child_project.title, part.valid_child_project %>
                  <% else %>
                    未作成
                  <% end %>
                </span>
                <span><%= part.child_project_state %> / <%= part.status %></span>
                <span>
                  <% if part.valid_child_project.present? %>
                    <%= link_to "子開発ページを見る", part.valid_child_project, class: "button button-small" %>
                  <% elsif part.developable? %>
                    <%= link_to "この部品を開発する", new_component_project_part_path(@project, part), class: "button button-small" %>
                  <% else %>
                    <span class="muted-note">詳細を見る</span>
                  <% end %>
                </span>
              </div>
            <% end %>
          </div>
        <% else %>
          <%= simple_format(@project.bill_of_materials) %>
        <% end %>
      </section>

    <% when "software" %>
      <section class="document-section">
        <h2><%= @section_label %></h2>
        <div class="software-flow">
          <% if @project.food? %>
            <span>材料</span>
            <span>分量</span>
            <span>手順</span>
            <span>写真</span>
            <span>試食結果</span>
            <span>改善メモ</span>
          <% else %>
            <span>入力層</span>
            <span>理解層</span>
            <span>判断層</span>
            <span>制御層</span>
            <span>安全層</span>
            <span>ログ</span>
          <% end %>
        </div>
        <%= simple_format(@project.software_design) %>
      </section>

    <% when "safety" %>
      <section class="document-section safety-section">
        <h2><%= @section_label %></h2>
        <% if @project.project_risks.any? %>
          <div class="risk-grid">
            <% @project.project_risks.each do |risk| %>
              <article class="risk-card">
                <div class="card-meta">
                  <span><%= risk.tracking_id %></span>
                  <span><%= risk.level %></span>
                  <span><%= risk.status %></span>
                </div>
                <h3><%= risk.hazard %></h3>
                <dl>
                  <div><dt>事故</dt><dd><%= risk.accident %></dd></div>
                  <div><dt>原因</dt><dd><%= risk.cause %></dd></div>
                  <div><dt>対策</dt><dd><%= risk.mitigation %></dd></div>
                  <div><dt>試験</dt><dd><%= risk.test_method %></dd></div>
                </dl>
              </article>
            <% end %>
          </div>
        <% end %>
        <%= simple_format(@project.safety_design) %>
      </section>

    <% when "manufacturing" %>
      <section class="document-section">
        <h2><%= @section_label %></h2>
        <%= simple_format(@project.manufacturing_steps) %>
      </section>

    <% when "tests" %>
      <section class="document-section">
        <h2><%= @section_label %></h2>
        <% if @project.project_test_items.any? %>
          <div class="test-list">
            <% @project.project_test_items.each_with_index do |item, index| %>
              <article class="test-item">
                <div class="card-meta">
                  <span><%= format("TEST-%03d", index + 1) %></span>
                  <span><%= item.status %></span>
                </div>
                <h3><%= item.title %></h3>
                <dl class="spec-list">
                  <div><dt>対応要求ID</dt><dd><%= item.success_relation %></dd></div>
                  <div><dt>合格基準</dt><dd><%= item.acceptance_criteria %></dd></div>
                  <div><dt>試験方法</dt><dd><%= item.test_method %></dd></div>
                  <div><dt>結果</dt><dd><%= item.result.presence || "未記録" %></dd></div>
                  <div><dt>証拠URL</dt><dd><%= item.evidence_url.present? ? link_to(item.evidence_url, item.evidence_url, target: "_blank", rel: "noopener") : "未登録" %></dd></div>
                </dl>
              </article>
            <% end %>
          </div>
        <% end %>
        <% if @project.test_plan.present? %>
          <% if @project.project_test_items.any? %>
            <section class="document-section">
              <h2>簡易チェックリスト</h2>
              <%= simple_format(@project.test_plan) %>
            </section>
          <% else %>
            <%= simple_format(@project.test_plan) %>
          <% end %>
        <% end %>
      </section>

    <% when "tasks" %>
      <section class="document-section">
        <h2><%= @section_label %></h2>
        <div class="task-board">
          <% @project.project_tasks.each_with_index do |task, index| %>
            <article>
              <span><%= format("TASK-%03d", index + 1) %> / <%= task.status %></span>
              <h3><%= task.title %></h3>
              <p><%= task.description %></p>
              <dl class="spec-list">
                <div><dt>関連要求ID</dt><dd><%= task.related_requirement_ids.presence&.join(", ") || "未設定" %></dd></div>
                <div><dt>関連部品ID</dt><dd><%= task.related_part_ids.presence&.join(", ") || "未設定" %></dd></div>
                <div><dt>関連安全項目ID</dt><dd><%= task.related_safety_ids.presence&.join(", ") || "未設定" %></dd></div>
                <div><dt>関連試験ID</dt><dd><%= task.related_test_ids.presence&.join(", ") || "未設定" %></dd></div>
                <div><dt>担当者</dt><dd><%= task.assignee.presence || "募集中" %></dd></div>
                <div><dt>状態</dt><dd><%= task.status %></dd></div>
              </dl>
            </article>
          <% end %>
        </div>
      </section>

    <% when "log" %>
      <section class="document-section">
        <h2>開発ログ</h2>
        <%= simple_format(@project.development_log) %>
      </section>

    <% when "join" %>
      <section class="document-section">
        <h2>参加募集</h2>
        <div class="role-grid workspace-role-grid">
          <% @project.role_cards.each do |role| %>
            <article>
              <div class="card-meta"><span><%= role[:status].presence || "募集中" %></span></div>
              <h3><%= role[:name] %></h3>
              <p><%= role[:description] %></p>
              <a class="button button-small" href="#new_contribution">この役割で参加する</a>
            </article>
          <% end %>
        </div>
        <p><%= @project.participation_needs %></p>

        <%= form_with model: [@project, @contribution], class: "contribution-form", id: "new_contribution" do |form| %>
          <% if @contribution.errors.any? %>
            <div class="errors">
              <strong>入力内容を確認してください。</strong>
            </div>
          <% end %>

          <div class="form-grid">
            <div class="field">
              <%= form.label :name, "名前" %>
              <%= form.text_field :name, placeholder: "表示名" %>
            </div>
            <div class="field">
              <%= form.label :kind, "種類" %>
              <%= form.select :kind, Contribution::KINDS %>
            </div>
          </div>

          <div class="field">
            <%= form.label :role, "立場・得意分野" %>
            <%= form.text_field :role, placeholder: "例: 機械設計、電気設計、安全レビュー" %>
          </div>

          <div class="field">
            <%= form.label :body, "内容" %>
            <%= form.text_area :body, rows: 5, placeholder: "レビュー、調査、部品候補、試作ログ、テスト結果を書いてください。" %>
          </div>

          <%= form.submit "成果物カードを追加", class: "button" %>
        <% end %>

        <div class="contribution-list">
          <% @project.contributions.order(created_at: :desc).each do |contribution| %>
            <% next if contribution.new_record? %>
            <article class="contribution">
              <div class="card-meta">
                <span><%= contribution.kind %></span>
                <span><%= contribution.role %></span>
              </div>
              <h3><%= contribution.name %></h3>
              <%= simple_format(contribution.body) %>
            </article>
          <% end %>
        </div>
      </section>

    <% when "artifacts" %>
      <section class="document-section">
        <h2><%= @section_label %></h2>
        <% if @project.component_project? && @project.parent_project.present? && @project.source_bom_item.present? %>
          <section class="parent-sync-panel">
            <p class="eyebrow">Parent BOM sync</p>
            <h3>親プロジェクトへ反映</h3>
            <p><%= @project.parent_project.title %> の <%= @project.source_bom_item.tracking_id %> <%= @project.source_bom_item.name %> を更新します。</p>
            <%= form_with model: @project.source_bom_item,
              url: sync_from_child_project_part_path(@project.parent_project, @project.source_bom_item),
              method: :post,
              class: "section-detail-form static-form" do |form| %>
              <div class="form-grid">
                <div class="field">
                  <%= form.label :candidate, "候補品" %>
                  <%= form.text_field :candidate, placeholder: "例: 低速ギヤードモーター案A" %>
                </div>
                <div class="field">
                  <%= form.label :procurement_policy, "調達方針" %>
                  <%= form.select :procurement_policy, ProjectPart::PROCUREMENT_POLICIES.map { |value, label| [label, value] } %>
                </div>
              </div>
              <div class="form-grid">
                <div class="field">
                  <%= form.label :estimated_price, "概算価格" %>
                  <%= form.text_field :estimated_price, placeholder: "例: 1,200円" %>
                </div>
                <div class="field">
                  <%= form.label :status, "状態" %>
                  <%= form.text_field :status, placeholder: "例: 候補確定" %>
                </div>
                <div class="field">
                  <%= form.label :note, "注意点" %>
                  <%= form.text_field :note, placeholder: "例: 死角の追加評価が必要" %>
                </div>
              </div>
              <%= form.submit "親BOMへ反映", class: "button" %>
            <% end %>
          </section>
        <% end %>
        <div class="artifact-grid">
          <% @project.project_artifacts.each do |artifact| %>
            <article>
              <div class="card-meta">
                <span><%= artifact.kind %></span>
                <span><%= artifact.status.presence || "未作成" %></span>
              </div>
              <h3><%= artifact.title %></h3>
              <p><%= artifact.notes %></p>
              <% if artifact.url.present? %>
                <%= link_to "開く", artifact.url, target: "_blank", rel: "noopener" %>
              <% end %>
            </article>
          <% end %>
        </div>
      </section>
    <% end %>

    <%= render "section_details",
      project: @project,
      detail: @project_section_detail,
      details: @section_details,
      section: @section,
      subsection: @design_section %>
  </section>
</main>
