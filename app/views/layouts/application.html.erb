<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "みんなの開発村" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <script async src="https://www.googletagmanager.com/gtag/js?id=AW-11111500959"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag("js", new Date());
      gtag("config", "AW-11111500959");
    </script>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <header class="site-header">
      <div class="topbar">
        <%= link_to "みんなの開発村", root_path, class: "brand" %>
        <nav>
          <%= link_to "開発テーマ", projects_path %>
          <%= link_to "投稿する", new_project_path, class: "button button-small" %>
        </nav>
      </div>

      <% if defined?(@project) && @project&.persisted? %>
        <nav class="workspace-header-nav" aria-label="開発ワークスペース">
          <% Project::WORKSPACE_SECTIONS.each do |section_key, section_label| %>
            <% path = section_key == "overview" ? project_path(@project) : project_section_path(@project, section: section_key) %>
            <%= link_to section_label, path, class: ("active" if @section == section_key) %>
          <% end %>
        </nav>
      <% end %>
    </header>

    <% flash.each do |type, message| %>
      <div class="flash <%= type %>"><%= message %></div>
    <% end %>

    <%= yield %>
  </body>
</html>
